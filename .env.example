# 개발 서버에서는 /api 요청을 VITE_API_PROXY_TARGET(백엔드)으로 프록시합니다.
# 백엔드 CORS는 Vercel 배포 Origin만 허용하므로 로컬에서는 이 프록시로 우회합니다.
# 배포 서버로 붙여 볼 때: VITE_API_PROXY_TARGET=https://teacherhub.duckdns.org
# Vercel 배포본은 vercel.json이 /api를 같은 백엔드로 rewrite하므로 VITE_API_BASE_URL=/api 그대로 씁니다.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_TIMEOUT_MS=15000
# 로그인·회원가입·회원가입 선택 항목(학교/학급/학생 번호) API. http면 백엔드 호출, 그 외(기본)는 localStorage mock.
# http 모드에는 이메일 인증 API가 없어 회원가입의 인증 단계를 생략합니다.
# dev 프로필 계정: teacher@test.com / admin@test.com / parent@test.com, 비밀번호 Test1234!
VITE_AUTH_API=mock
VITE_MOCK_AUTH_DELAY_MS=250
VITE_MOCK_AUTH_SESSION_TTL_MS=1800000
# 교사 메시지함 조회 API(목록·상세·대화·위험 요소·처리 기록·원문 열람). http면 백엔드 호출, 그 외(기본)는 로컬 mock 메시지함.
# 백엔드 JWT가 필요하므로 VITE_AUTH_API=http와 함께 켭니다. 답변 전송·상담 완료는 아직 연동되지 않았습니다.
VITE_MESSAGE_API=mock
# 관리자 공유·위험도 검토·Emergency 재검토 API. http면 백엔드 호출, 그 외(기본)는 localStorage mock.
# 백엔드는 JWT가 필요하므로 http로 쓰려면 VITE_AUTH_API=http도 함께 켜야 합니다(mock 토큰은 401).
# 메시지함이 mock이면(VITE_MESSAGE_API=mock) 숫자 complaintId가 없어 위험도 검토·공유 요청을 보내지 않습니다.
VITE_ESCALATION_API=mock
